# synth.ys - Yosys synthesis + PPA report for the default WFA arbiter
#
# rtl/fair_arbiter.v is the Wavefront / WWFA implementation:
#   P = max(N,M) torus diagonals, P wavefront stages, rotating column offset.
#
# No standard-cell liberty file is assumed: "cells" is the count of generic
# gate-level cells after ABC mapping, and "ltp -noff" is the longest topological
# path (logic depth in mapped gates).  The user-visible target is <= 40 levels
# for the matching datapath.
#
# Usage: yosys -s synth.ys

# ---------------------------------------------------------------------------
# 8x8 baseline
# ---------------------------------------------------------------------------
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 8 -set M 8 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff

# ---------------------------------------------------------------------------
# 10x10 (explicitly requested N=M=10 case)
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 10 -set M 10 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff
write_verilog -noattr synth/fair_arbiter_10x10_wfa.v

# ---------------------------------------------------------------------------
# 9x11 / 11x9: rectangular, P=11
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 9 -set M 11 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff

design -reset
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 11 -set M 9 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff

# ---------------------------------------------------------------------------
# 16x16: depth > 40, candidate for 2-cycle pipeline / 4x4 hierarchy
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 16 -set M 16 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff

# ---------------------------------------------------------------------------
# Reset vs no-reset (delta register), 8x8
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/fair_arbiter.v
chparam -set N 8 -set M 8 -set PTR_RESET 0 fair_arbiter
synth -top fair_arbiter
stat
ltp -noff
