# synth_islip.ys - Yosys synthesis + PPA report for the iSLIP+fill reference
# (rtl/reference/fair_arbiter_islip.v).  The default WFA is synth/synth.ys.
#
# Synthesizes the arbiter for several configurations and prints cell/area
# statistics for each.  No standard-cell liberty file is assumed, so "area" is
# reported as the count of gate-level cells after ABC technology mapping to
# Yosys's generic gate library.  "ltp" reports the longest topological path
# (logic depth in mapped gates).
#
# The residual-fill stage is always present (it guarantees maximality), so
# every number below already includes it.
#
# Usage: yosys -s synth.ys

# ---------------------------------------------------------------------------
# ITER sweep (8x8, AUGMENT=0): cost of the greedy matching passes.
# ---------------------------------------------------------------------------
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 1 -set AUGMENT 0 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 2 -set AUGMENT 0 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 3 -set AUGMENT 0 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 4 -set AUGMENT 0 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

# ---------------------------------------------------------------------------
# AUGMENT comparison (8x8, ITER=4): cost of the swap (larger matching).
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 4 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff
write_verilog -noattr synth/fair_arbiter_8x8_iter4_aug1.v

# ---------------------------------------------------------------------------
# PPA sweet spot: AUGMENT=1 at lower ITER (same throughput at 8x8, less area).
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 1 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set ITER 2 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

# ---------------------------------------------------------------------------
# Reset vs no-reset (8x8, ITER=4, AUGMENT=1)
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set PTR_RESET 0 -set ITER 4 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat

# ---------------------------------------------------------------------------
# Scaling: default 10x10, 16x16, and 8x4 (N > M).
# ---------------------------------------------------------------------------
design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set N 10 -set M 10 -set ITER 4 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set N 10 -set M 10 -set ITER 2 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set N 16 -set M 16 -set ITER 4 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff

design -reset
read_verilog -sv rtl/reference/fair_arbiter_islip.v
chparam -set N 8 -set M 4 -set ITER 4 -set AUGMENT 1 fair_arbiter_islip
synth -top fair_arbiter_islip
stat
ltp -noff
