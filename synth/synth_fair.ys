# synth_fair.ys - synthesis / depth for the optional fair variant
# (iSLIP first pass + WFA fill, rtl/fair_arbiter_fair.v).
# The fast default is synthesized by synth/synth.ys.

read_verilog -sv rtl/wfa_core.v rtl/fair_arbiter_fair.v
chparam -set N 8 -set M 8 fair_arbiter_fair
synth -top fair_arbiter_fair
flatten
stat
ltp -noff

design -reset
read_verilog -sv rtl/wfa_core.v rtl/fair_arbiter_fair.v
chparam -set N 10 -set M 10 fair_arbiter_fair
synth -top fair_arbiter_fair
flatten
stat
ltp -noff

design -reset
read_verilog -sv rtl/wfa_core.v rtl/fair_arbiter_fair.v
chparam -set N 9 -set M 11 fair_arbiter_fair
synth -top fair_arbiter_fair
flatten
stat
ltp -noff

design -reset
read_verilog -sv rtl/wfa_core.v rtl/fair_arbiter_fair.v
chparam -set N 11 -set M 9 fair_arbiter_fair
synth -top fair_arbiter_fair
flatten
stat
ltp -noff
